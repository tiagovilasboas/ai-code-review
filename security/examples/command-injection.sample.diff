 package tools
 
 import (
 	"net/http"
 	"os/exec"
 )
 
 func Uptime(w http.ResponseWriter, r *http.Request) {
 	out, _ := exec.Command("uptime").Output()
 	w.Write(out)
 }
 
+func Ping(w http.ResponseWriter, r *http.Request) {
+	host := r.URL.Query().Get("host")
+	out, err := exec.Command("sh", "-c", "ping -c 1 "+host).Output()
+	if err != nil {
+		http.Error(w, "ping failed", http.StatusBadGateway)
+		return
+	}
+	w.Write(out)
+}
+
+func Trace(w http.ResponseWriter, r *http.Request) {
+	host := r.URL.Query().Get("host")
+	out, _ := exec.Command("traceroute", "-m", "5", host).Output()
+	w.Write(out)
+}
