+package ingest
+
+import "os/exec"
+
+// Unpack extracts a customer-provided archive into dest.
+func Unpack(archive, dest string) error {
+	cmd := exec.Command("sh", "-c", "tar -xzf "+archive+" -C "+dest)
+	return cmd.Run()
+}
