+package acme.test.web;
+
+import io.vertx.ext.web.Router;
+
+public final class Greet {
+    public static void mount(Router router) {
+        router.get("/greet").handler(rc -> {
+            String who = rc.request().getParam("who");
+            rc.response().putHeader("Content-Type", "text/html").end("<p>Hi " + who + "</p>");
+        });
+    }
+}
