+import DOMPurify from 'isomorphic-dompurify';
+export function Post({ md }: { md: string }) {
+  const safeHtml = useMemo(() => DOMPurify.sanitize(marked(md)), [md]);
+  return <section dangerouslySetInnerHTML={{ __html: safeHtml }} />;
+}
