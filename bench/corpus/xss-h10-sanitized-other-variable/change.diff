+import DOMPurify from 'dompurify';
+export function Preview({ title, body }: { title: string; body: string }) {
+  const cleanTitle = DOMPurify.sanitize(title);
+  return <div><h2>{cleanTitle}</h2><div dangerouslySetInnerHTML={{ __html: body }} /></div>;
+}
