diff --git a/src/main/java/com/example/docs/DocumentResource.java b/src/main/java/com/example/docs/DocumentResource.java
index 1111111..2222222 100644
--- a/src/main/java/com/example/docs/DocumentResource.java
+++ b/src/main/java/com/example/docs/DocumentResource.java
@@ -25,4 +25,16 @@ public class DocumentResource {
 public class DocumentResource {
     @Inject EntityManager em;
 
+    @DELETE
+    @Path("/{id}")
+    @RolesAllowed("user")
+    @Transactional
+    public Response delete(@PathParam("id") Long id) {
+        Document doc = em.find(Document.class, id);
+        if (doc == null) {
+            return Response.status(Response.Status.NOT_FOUND).build();
+        }
+        em.remove(doc);
+        return Response.noContent().build();
+    }
 }
