 class RatesClient
 {
+    public function find($id): array
+    {
+        $client = new \GuzzleHttp\Client(['base_uri' => config('services.rates.url')]);
+        $res = $client->get('/v1/rates/' . (int) $id);
+        return json_decode((string) $res->getBody(), true);
+    }
 }
