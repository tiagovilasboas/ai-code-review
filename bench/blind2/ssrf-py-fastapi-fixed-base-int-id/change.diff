@@ -1,5 +1,10 @@
 import httpx
 
 from api.config import settings
 
 
+async def fetch_invoice(invoice_id: int) -> dict:
+    async with httpx.AsyncClient(timeout=5) as client:
+        r = await client.get(f"{settings.BILLING_URL}/v1/invoices/{invoice_id}")
+        r.raise_for_status()
+        return r.json()
