@@ -1,8 +1,16 @@
 package rates
 
 import (
 	"net/http"
 	"net/url"
 	"regexp"
 )
 
+var currencyRe = regexp.MustCompile(`^[A-Z]{3}$`)
+
+func Lookup(c *http.Client, currency string) (*http.Response, error) {
+	if !currencyRe.MatchString(currency) {
+		return nil, errBadCurrency
+	}
+	return c.Get("https://api.example.com/v1/rates/" + url.PathEscape(currency))
+}
