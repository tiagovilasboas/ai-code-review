 final class ChangelogService
 {
+    public function recent(int $n): array
+    {
+        $process = new Process(['git', 'log', '--oneline', '-n', (string) $n]);
+        $process->mustRun();
+        return explode("\n", trim($process->getOutput()));
+    }
