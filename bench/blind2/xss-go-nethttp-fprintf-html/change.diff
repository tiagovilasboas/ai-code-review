 package main
 
 import (
 	"fmt"
 	"net/http"
 )
 
+func greet(w http.ResponseWriter, r *http.Request) {
+	w.Header().Set("Content-Type", "text/html; charset=utf-8")
+	fmt.Fprintf(w, "<h1>Hello, %s</h1>", r.URL.Query().Get("name"))
+}
