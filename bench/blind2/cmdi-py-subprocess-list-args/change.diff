@@ -1,3 +1,12 @@
 import subprocess
 
 
+def recent_commits(count):
+    n = int(count)
+    result = subprocess.run(
+        ["git", "log", "--oneline", "-n", str(n)],
+        check=True,
+        capture_output=True,
+        text=True,
+    )
+    return result.stdout.splitlines()
