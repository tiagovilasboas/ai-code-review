 const FORMATS = new Set(['png', 'jpg', 'webp']);
+router.post('/convert', (req, res) => {
+  const { format } = req.body;
+  if (!FORMATS.has(format)) return res.sendStatus(400);
+  execFile('convert', ['in.bin', `out.${format}`], (err) => res.sendStatus(err ? 500 : 200));
+});
