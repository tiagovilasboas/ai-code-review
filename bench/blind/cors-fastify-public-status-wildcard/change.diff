+import type { FastifyInstance } from 'fastify';
+
+// Unauthenticated, read-only status feed embedded by partner status pages.
+export default async function publicStatus(app: FastifyInstance) {
+  app.get('/status.json', async (_req, reply) => {
+    reply.header('Access-Control-Allow-Origin', '*');
+    reply.header('Cache-Control', 'public, max-age=30');
+    return { status: 'operational', updatedAt: new Date().toISOString() };
+  });
+}
