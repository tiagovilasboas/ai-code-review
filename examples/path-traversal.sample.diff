# Synthetic sample PR diff (path traversal)
# Intentionally serves a file whose name comes from req.params with no
# base-directory check. The guarded preview handler and the fixed logo path
# are on purpose (not findings). Not production code. No exploit PoC.
#
# Apply: skills/injection.md
# Expected shape: examples/path-traversal.sample-report.md

diff --git a/src/api/files.ts b/src/api/files.ts
index 1111111..2222222 100644
--- a/src/api/files.ts
+++ b/src/api/files.ts
@@ -1,12 +1,25 @@
 import path from "path";
 import { Request, Response } from "express";
 
 const UPLOAD_DIR = path.resolve(__dirname, "uploads");
 
 export function logo(_req: Request, res: Response) {
   return res.sendFile(path.join(__dirname, "static", "logo.png"));
 }
 
+export function download(req: Request, res: Response) {
+  const file = path.join(UPLOAD_DIR, req.params.name);
+  return res.sendFile(file);
+}
+
+export function preview(req: Request, res: Response) {
+  const target = path.resolve(UPLOAD_DIR, req.params.name);
+  if (!target.startsWith(UPLOAD_DIR + path.sep)) {
+    return res.status(400).json({ error: "invalid path" });
+  }
+  return res.sendFile(target);
+}
+
 export function health(_req: Request, res: Response) {
   return res.json({ ok: true });
 }
